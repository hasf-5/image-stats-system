# ===== 运行环境 =====
NODE_ENV=development
PORT=3000

# ===== 数据库（MySQL 8）=====
# 本地直连（node 跑在宿主机时用 127.0.0.1）
DATABASE_URL="mysql://imgstats:imgstats_pwd@127.0.0.1:3306/imgstats?connection_limit=10&pool_timeout=20"

# ===== Redis =====
REDIS_URL="redis://127.0.0.1:6379/0"

# ===== JWT =====
# 生产必须替换：openssl rand -hex 48
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ===== 上传 =====
# 宿主机磁盘目录（Docker 中映射到 /app/uploads 并挂载 volume）
UPLOAD_DIR="./uploads"
# 对外访问前缀，Nginx 会直接托管该路径；后续切对象存储只改这里 + StorageDriver
UPLOAD_PUBLIC_PREFIX="/uploads"
MAX_UPLOAD_SIZE_MB=20

# ===== 业务 =====
TZ=Asia/Shanghai
# 登录失败锁定策略
LOGIN_MAX_FAIL=5
LOGIN_LOCK_SECONDS=600

# ===== 初始管理员（仅 seed 使用）=====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
