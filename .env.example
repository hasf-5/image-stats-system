# =====================================================================
# docker compose 使用的环境变量（复制为 .env 后修改）
#   cp .env.example .env
# =====================================================================

# 你的域名（DNS A 记录需先指向服务器公网 IP）
DOMAIN=img.example.com

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_pwd
MYSQL_PASSWORD=CHANGE_ME_app_pwd

# ---- JWT（生产必须替换：openssl rand -hex 48）----
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_48bytes
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_48bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- 上传 ----
MAX_UPLOAD_SIZE_MB=20
UPLOAD_PUBLIC_PREFIX=/uploads

# ---- 业务 ----
TZ=Asia/Shanghai
LOGIN_MAX_FAIL=5
LOGIN_LOCK_SECONDS=600

# ---- 首次初始化管理员（docker compose run --rm -e RUN_SEED=true server 时生效）----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456

# ---- 允许的前端来源（同域部署可留空，仅本地开发需要）----
CORS_ORIGIN=https://img.example.com
